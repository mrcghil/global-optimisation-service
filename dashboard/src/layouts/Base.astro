---
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · goss dashboard</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={base}>goss<span>results</span></a>
      <nav>
        <a href={base}>Index</a>
      </nav>
    </header>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
    <style is:global>
      :root {
        --bg: #0f1115; --panel: #171a21; --fg: #e6e6e6; --muted: #9aa0aa;
        --accent: #4f9dff; --ok: #45c477; --bad: #ff6b6b; --border: #262b34;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); }
      .topbar {
        display: flex; align-items: center; gap: 1.5rem;
        padding: 0.75rem 1.25rem; background: var(--panel);
        border-bottom: 1px solid var(--border);
      }
      .brand { font-weight: 700; font-size: 1.15rem; color: var(--fg); text-decoration: none; }
      .brand span { color: var(--accent); margin-left: 0.25rem; }
      nav a { color: var(--muted); text-decoration: none; margin-right: 1rem; }
      nav a:hover { color: var(--fg); }
      main { max-width: 900px; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
      h1 { font-size: 1.5rem; margin: 0.5rem 0 1rem; }
      h2 { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; color: var(--muted); }
      a { color: var(--accent); }
      code { background: #0b0d11; padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.85em; }
      .meta { color: var(--muted); font-size: 0.9rem; }
      .muted { color: var(--muted); }
      .error { color: var(--bad); }
      .cards { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
      .card {
        background: var(--panel); border: 1px solid var(--border);
        border-radius: 8px; padding: 0.8rem 1rem;
        display: flex; flex-direction: column; gap: 0.25rem;
      }
      .card .stat { color: var(--muted); font-size: 0.85rem; }
      figure.chart {
        background: var(--panel); border: 1px solid var(--border);
        border-radius: 8px; padding: 0.75rem 1rem; margin: 1rem 0;
      }
      figure.chart figcaption { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.5rem; }
      .axis-label, .legend-label { fill: var(--muted); font-size: 12px; }
      text { fill: var(--fg); }
      .cell { cursor: pointer; transition: opacity 0.1s; }
      .cell:hover { opacity: 0.8; stroke: var(--fg); stroke-width: 2; }
      table.runs { width: 100%; border-collapse: collapse; margin-top: 1rem; }
      table.runs th, table.runs td {
        text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--border);
      }
      table.runs th { color: var(--muted); font-weight: 600; }
      .ok { color: var(--ok); } .bad { color: var(--bad); }
      .banner {
        border-radius: 8px; padding: 0.75rem 1rem; margin: 1rem 0;
        border: 1px solid var(--border); background: var(--panel);
      }
      .banner.ok { border-left: 4px solid var(--ok); }
      .banner.bad { border-left: 4px solid var(--bad); }
      .banner .advice { color: var(--muted); font-size: 0.9rem; margin-top: 0.4rem; }
      .params { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.5rem 0; }
      .pill {
        background: #0b0d11; border: 1px solid var(--border);
        border-radius: 999px; padding: 0.2rem 0.7rem; font-size: 0.85rem;
      }
      details.provenance { margin-top: 1.5rem; color: var(--muted); }
      details.provenance dl { display: grid; grid-template-columns: auto 1fr; gap: 0.2rem 1rem; }
      details.provenance dt { color: var(--muted); }
    </style>
  </body>
</html>
